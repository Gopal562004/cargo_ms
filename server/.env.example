# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/awb_db?schema=public"

# JWT Configuration
JWT_SECRET="your-super-secret-access-token-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-token-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server Configuration
PORT=5000
NODE_ENV=development

# Client URL (CORS allowed origin)
CLIENT_URL="http://localhost:5173"
